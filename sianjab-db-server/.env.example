# SEC-K3: salin ke .env dan ISI SEMUA NILAI — server menolak start bila ada yang kosong.
# JANGAN pernah commit file .env ini ke git.
HOMESERVER_SECRET=
API_SECRET=
FIREBASE_SECRET=
SITPP_SECRET=
